import pandas as pd
from collections import Counter
import random

# ================= CONFIG =================
SATURDAY_FILE = "Saturday_data.csv"
BATCH_SIZE = 10
N_ITERATIONS = 1000      # random search iterations per batch
RANDOM_SEED = 42

# ================= HELPERS =================
def dec(n):
    if n <= 9: return '0s'
    if n <= 19: return '10s'
    if n <= 29: return '20s'
    if n <= 39: return '30s'
    return '40s'

def parse_main_str(s):
    if pd.isna(s) or s == "":
        return []
    return [int(x.strip()) for x in s.split(',') if x.strip().isdigit()]

# ================= LOAD DATA =================
sat_df = pd.read_csv(SATURDAY_FILE)
sat_df["Date_dt"] = pd.to_datetime(sat_df["Date"], format="%a %d-%b-%Y", errors="coerce")
sat_df["nums"] = sat_df["Main"].apply(parse_main_str)
sat_df = sat_df[["Date_dt", "nums"]].dropna(subset=["nums"]).sort_values("Date_dt")

no40_df = sat_df[sat_df["nums"].apply(lambda nums: all(dec(n) != "40s" for n in nums))].copy().sort_values("Date_dt").reset_index(drop=True)

print(f"Total no-40 Saturday draws: {len(no40_df)}")
print(f"Total batches of {BATCH_SIZE} draws: {len(no40_df) // BATCH_SIZE}\n")

# ================= FITNESS FUNCTIONS =================
def count_six(pool, draws):
    pool_set = set(pool)
    return sum(1 for nums in draws if set(nums).issubset(pool_set))

def count_five_plus(pool, draws):
    pool_set = set(pool)
    return sum(1 for nums in draws if len(set(nums) & pool_set) >= 5)

# ================= OPTIMIZE POOL ON A BATCH =================
def optimize_pool_on_batch(batch_nums, n_iterations):
    random.seed(RANDOM_SEED)

    # Initial pool = top 15 most frequent numbers in batch
    freq = Counter()
    for nums in batch_nums:
        freq.update(nums)
    initial_pool = [n for n, _ in freq.most_common(15)]

    best_pool = initial_pool.copy()
    best_six = count_six(best_pool, batch_nums)

    for _ in range(n_iterations):
        candidate = best_pool.copy()
        for _ in range(random.randint(1, 2)):
            if candidate:
                remove_n = random.choice(candidate)
                add_n = random.choice([n for n in range(1, 40) if n not in candidate])
                candidate.remove(remove_n)
                candidate.append(add_n)

        cand_six = count_six(candidate, batch_nums)
        if cand_six > best_six:
            best_six = cand_six
            best_pool = candidate.copy()

    return sorted(best_pool), best_six

# ================= MAIN LOOP =================
results = []
start_idx = 0
batch_num = 1

print("Running brute-force optimization per batch...\n")
print("=" * 100)

while start_idx < len(no40_df):
    end_idx = min(start_idx + BATCH_SIZE, len(no40_df))
    batch = no40_df.iloc[start_idx:end_idx]

    if len(batch) < BATCH_SIZE:
        # skip incomplete last batch if not full 10
        break

    batch_nums = list(batch["nums"])
    date_start = pd.to_datetime(batch.iloc[0]["Date_dt"]).strftime('%d-%b-%Y')
    date_end = pd.to_datetime(batch.iloc[-1]["Date_dt"]).strftime('%d-%b-%Y')

    pool, six_in_batch = optimize_pool_on_batch(batch_nums, N_ITERATIONS)
    five_in_batch = count_five_plus(pool, batch_nums)

    results.append({
        'batch': batch_num,
        'date_start': date_start,
        'date_end': date_end,
        'pool': pool,
        'six': six_in_batch,
        'five': five_in_batch,
    })

    if six_in_batch > 0:
        print(f"Batch {batch_num:2d} | {date_start} to {date_end} | 6/6 = {six_in_batch} | 5+ = {five_in_batch} | pool={pool}")
    else:
        print(f"Batch {batch_num:2d} | {date_start} to {date_end} | 6/6 = 0 | 5+ = {five_in_batch}")

    batch_num += 1
    start_idx += BATCH_SIZE

# ================= SUMMARY =================
total_batches = len(results)
batches_with_six = sum(1 for r in results if r['six'] > 0)
total_six = sum(r['six'] for r in results)
total_five = sum(r['five'] for r in results)

print("\n" + "=" * 100)
print("SUMMARY")
print("=" * 100)
print(f"Total batches: {total_batches}")
print(f"Batches with at least one 6/6: {batches_with_six}")
print(f"Total 6/6 traps across all in-sample batches: {total_six}")
print(f"Total 5+ traps across all in-sample batches: {total_five}")

# Distribution of 6/6 counts
dist = Counter(r['six'] for r in results)
print("\nDistribution of in-sample 6/6 counts per batch:")
for count in sorted(dist.keys()):
    print(f"  6/6 = {count}: {dist[count]} batches")


